void lisaaKolmio(int kolmio, int vertexi){
	if(vertexit[vertexi].kolmiomaara<6){
		vertexit[vertexi].kolmiot[vertexit[vertexi].kolmiomaara]=kolmio;
		vertexit[vertexi].kolmiomaara++;
	}

}

void alustaLippu(){
  int i,j;

  /*	Alustetaan kaikki vertexit antamalla niille sijainnit ja laskemalla niille
		naapuriverteksit*/
	//printf("Varataan muistia %i tavua\n",sizeof(vertex)*LIPUN_Y_VERTEXIT*LIPUN_X_VERTEXIT);
  vertexit=(vertex*)malloc(sizeof(vertex)*LIPUN_Y_VERTEXIT*LIPUN_X_VERTEXIT);
  for(i=0;i<LIPUN_Y_VERTEXIT;i++){
    for(j=0;j<LIPUN_X_VERTEXIT;j++){
      vertexit[(i*LIPUN_X_VERTEXIT)+j].kolmiomaara = 0;
      vertexit[(i*LIPUN_X_VERTEXIT)+j].position[0] =
				0.2f+(float)j/(float)LIPUN_X_VERTEXIT*LIPUN_LEVEYS;
      vertexit[(i*LIPUN_X_VERTEXIT)+j].position[1] =
				TANGON_KORKEUS-0.3f-(float)i/(float)LIPUN_Y_VERTEXIT*LIPUN_KORKEUS;
      vertexit[(i*LIPUN_X_VERTEXIT)+j].position[2]= 0;
      vertexit[(i*LIPUN_X_VERTEXIT)+j].texCoord[0]=(float)j/(LIPUN_X_VERTEXIT-1);
      vertexit[(i*LIPUN_X_VERTEXIT)+j].texCoord[1]=(float)i/(LIPUN_Y_VERTEXIT-1);
      vertexit[(i*LIPUN_X_VERTEXIT)+j].force[0]=0;
      vertexit[(i*LIPUN_X_VERTEXIT)+j].force[1]=0;
      vertexit[(i*LIPUN_X_VERTEXIT)+j].force[2]=0;
			vertexit[(i*LIPUN_X_VERTEXIT)+j].v[0]=0;
			vertexit[(i*LIPUN_X_VERTEXIT)+j].v[1]=0;
			vertexit[(i*LIPUN_X_VERTEXIT)+j].v[2]=0;
//		  printf("vertex %i, %i pos:%i,%i,%i\n",j,i
//																							,(int)vertexit[(i*LIPUN_X_VERTEXIT)+j].position[0]
//																							,(int)vertexit[(i*LIPUN_X_VERTEXIT)+j].position[1]
//																							,(int)vertexit[(i*LIPUN_X_VERTEXIT)+j].position[2]);
		}
	}
	  /*	Naapurivertexej‰ varten k‰yd‰‰n l‰pi kaikki mahdollisuudet,
			eli kulmat, reunat ja sisus.
	  */
  for(i=0;i<LIPUN_Y_VERTEXIT;i++){
    for(j=0;j<LIPUN_X_VERTEXIT;j++){
      if(i==0){
				if(j==0){
					vertexit[(i*LIPUN_X_VERTEXIT)+j].naapureidenMaara=2;
					vertexit[(i*LIPUN_X_VERTEXIT)+j].naapurit[0]=&vertexit[1];
					vertexit[(i*LIPUN_X_VERTEXIT)+j].naapurit[1]=&vertexit[LIPUN_X_VERTEXIT];
	  
					vertexit[(i*LIPUN_X_VERTEXIT)+j].naapureidenMaara2=1;
					vertexit[(i*LIPUN_X_VERTEXIT)+j].naapurit[4]=&vertexit[LIPUN_X_VERTEXIT+1];
				}else if(j==LIPUN_X_VERTEXIT-1){
					vertexit[(i*LIPUN_X_VERTEXIT)+j].naapureidenMaara=2;
					vertexit[(i*LIPUN_X_VERTEXIT)+j].naapurit[0]=&vertexit[LIPUN_X_VERTEXIT-2];
