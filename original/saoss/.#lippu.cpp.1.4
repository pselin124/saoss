void normVectorProd(GLfloat *v1, GLfloat *v2, float *norm) {
  GLfloat lenght;

  norm[0] = v1[1]*v2[2] - v1[2]*v2[1];
  norm[1] = v1[2]*v2[0] - v1[0]*v2[2];
  norm[2] = v1[0]*v2[1] - v1[1]*v2[0];
  
  lenght = sqrt(pow(norm[0],2)+pow(norm[1],2)+pow(norm[2],2) );

  norm[0] /= lenght;
  norm[1] /= lenght;
  norm[2] /= lenght;
}



/* Hoitaa kaiken laskennan - eli simuloi tuulen vaikutusta ja lipun liehuntaa 
   -> laskee vertexien uudet sijainnit */

void calculate(int framecount){
  int i,j,k;
	tuulikulma=sin((framecount-600)/400.0f);
	tuulenvoimakkuus=0.001*sin(framecount/1000.0f-1.0f);
  /* Tuulen vaikutus - k‰yd‰‰n kaikki kolmiot l‰pi
     ja lis‰t‰‰n kolmioiden kaikkiin vertekseihin kolmioon kohdistuva voima. */
  float tuulix=sin(tuulikulma)*tuulenvoimakkuus*0.2;
  float tuuliy=0;
  float tuuliz=cos(tuulikulma)*tuulenvoimakkuus*0.2;

  for(i=0;i<(LIPUN_Y_VERTEXIT-1)*(LIPUN_X_VERTEXIT-1)*2;i++){
    //force = unitvector(normal) * dotproduct(normal, wind)
    //add force to all points making up this triangle 

    float voima[3];
    float pistetulo = trianglet[i].normal[0]*tuulix+
                      trianglet[i].normal[1]*tuuliy+
                      trianglet[i].normal[2]*tuuliz;
    for(k=0;k<3;k++){
      voima[k]=trianglet[i].normal[k]*pistetulo;
    }
    for(j=0;j<3;j++){
      for(k=0;k<3;k++){
				trianglet[i].kulmat[j]->force[k]+=voima[k];
      }
    }
  }


  // Lasketaan jokaisen vertexin jokaiselle naapurille voimavektori
   
  int n;
  double lepoetaisyys=LIPUN_LEVEYS/LIPUN_X_VERTEXIT;//lepoetaisyys
  double lepoetaisyys2=sqrt(2)*lepoetaisyys;//lepoetaisyys vinossa oleville vertexeille
	/*	Seuraavassa i osoittaa suoraan k‰sitelt‰v‰‰n vertexiin,
		k on sarakkeen numero ja n on rivin numero. j on suora osoitus
		k‰sitelt‰v‰‰n naapurivertexiin. */
  for(i=0,k=0,n=0;i<LIPUN_Y_VERTEXIT*LIPUN_X_VERTEXIT;i++,k++){
    if(k==LIPUN_X_VERTEXIT){
      k=0;
      n++;
    }
    vertexit[i].force[1]-=0.000058;//gravity
    
    // Ensin lasketaan vieress‰ olevat jouset. 
    if((n%2==0 && k%2==0) || (n%2==1 && k%2==1)){
      for(j=0;j<vertexit[i].naapureidenMaara;j++){
				float et[3];
				int ij;
				for(ij=0;ij<3;ij++){
					et[ij]=(vertexit[i].position[ij])//+vertexit[i].v[ij])
						-(vertexit[i].naapurit[j]->position[ij]);//+vertexit[i].naapurit[j]->v[ij]);
				}
				float etaisyys=sqrt(et[0]*et[0]+et[1]*et[1]+et[2]*et[2]);//etaisyysvektorin pituus
				float suhde;
				float etaisyystemp=1.0f/etaisyys;
				suhde=(etaisyys-lepoetaisyys)/lepoetaisyys;
				et[0]=et[0]*etaisyystemp;
				et[1]=et[1]*etaisyystemp;
				et[2]=et[2]*etaisyystemp;
				if(etaisyys!=0){
					float force[3];
					force[0]=et[0]*suhde*gravitaatiovakio;
					force[1]=et[1]*suhde*gravitaatiovakio;
					force[2]=et[2]*suhde*gravitaatiovakio;
	  
					vertexit[i].force[0]-=force[0];
					vertexit[i].force[1]-=force[1];
					vertexit[i].force[2]-=force[2];

				  vertexit[i].naapurit[j]->force[0]+=force[0];
					vertexit[i].naapurit[j]->force[1]+=force[1];
					vertexit[i].naapurit[j]->force[2]+=force[2];
				}
      }
    }

    // Sitten vinosuunnassa olevat jouset. 
    if(k%2==0){
      for(j=4;j<vertexit[i].naapureidenMaara2+4;j++){
				float et[3];
				int ij;
				for(ij=0;ij<3;ij++){
					et[ij]=(vertexit[i].position[ij])//+vertexit[i].v[ij])
						-(vertexit[i].naapurit[j]->position[ij]);//+vertexit[i].naapurit[j]->v[ij]);
				}
				float etaisyys=sqrt(et[0]*et[0]+et[1]*et[1]+et[2]*et[2]);//etaisyysvektorin pituus
				float suhde;
				float etaisyystemp=1/etaisyys;
				suhde=(etaisyys-lepoetaisyys2)/lepoetaisyys2;
				et[0]=et[0]*etaisyystemp;
				et[1]=et[1]*etaisyystemp;
				et[2]=et[2]*etaisyystemp;
				if(etaisyys!=0){
					float force[3];
					force[0]=et[0]*suhde*gravitaatiovakio;
					force[1]=et[1]*suhde*gravitaatiovakio;
					force[2]=et[2]*suhde*gravitaatiovakio;
	  
					vertexit[i].force[0]-=force[0];
					vertexit[i].force[1]-=force[1];
					vertexit[i].force[2]-=force[2];
		  
				  vertexit[i].naapurit[j]->force[0]+=force[0];
					vertexit[i].naapurit[j]->force[1]+=force[1];
					vertexit[i].naapurit[j]->force[2]+=force[2];
				}
      }
    }

    // Huolehditaan ett‰ reuna pysyy l‰hell‰ tankoa. 
    if(k==0){
      if(i==0 || i==(LIPUN_Y_VERTEXIT-1)*LIPUN_X_VERTEXIT){
				float et[3];
				et[0]=vertexit[i].position[0];
				et[2]=vertexit[i].position[2];
				if(i==0){
					et[1]=vertexit[i].position[1]-TANGON_KORKEUS;
				}else{
					et[1]=vertexit[i].position[1]-(TANGON_KORKEUS-LIPUN_KORKEUS-1.3);
				}
				double etaisyys=sqrt(et[0]*et[0]+et[1]*et[1]+et[2]*et[2]);
				if(etaisyys>0.3){
					vertexit[i].force[0]-=et[0]*pow((etaisyys-0.3),3)*0.2;
					vertexit[i].force[1]-=et[1]*pow((etaisyys-0.3),3)*0.2;
					vertexit[i].force[2]-=et[2]*pow((etaisyys-0.3),3)*0.2;
				}
      }
    }
  
    //lasketaan lopuksi kitka jottei lippu j‰isi pyˆrim‰‰n tuulen lakatessa.
    int l;
    for(l=0;l<3;l++)
      vertexit[i].v[l]/=1.00185f;
  }


  /* Lis‰t‰‰n voimavektorit vertexien sijaintiin.. */
  for(i=0;i<LIPUN_Y_VERTEXIT*LIPUN_X_VERTEXIT;i++){
    float etaisyys=sqrt(pow(vertexit[i].position[0]+vertexit[i].force[0],2)+
			pow(vertexit[i].position[2]+vertexit[i].force[2],2));
    for(k=0;k<3;k++){
      vertexit[i].v[k]+=vertexit[i].force[k];
      vertexit[i].force[k]=0;
    }
    if(etaisyys>0.29){
      for(k=0;k<3;k++){
/*				if(framecount==3){
					printf("vertex %i position %i=%i\n",i,k,(int) vertexit[i].position[k]);
				}*/
			vertexit[i].position[k]+=vertexit[i].v[k];
      }
    }else{
      vertexit[i].position[0]=(vertexit[i].position[0]+vertexit[i].v[0])/etaisyys*0.29f;
      vertexit[i].position[2]=(vertexit[i].position[2]+vertexit[i].v[2])/etaisyys*0.29f;
      vertexit[i].v[0]=0;
      vertexit[i].v[2]=0;
      vertexit[i].v[1]=0;
    }
  }

  /* Lasketaan jokaiselle lipun kolmiolle normaalit */
  for (i=0; i<2*(LIPUN_X_VERTEXIT-1)*(LIPUN_Y_VERTEXIT-1); i++) {
    for (j=0; j<3; j++) {
      hold1[j] = trianglet[i].kulmat[1]->position[j] - 
	         trianglet[i].kulmat[0]->position[j];
      hold2[j] = trianglet[i].kulmat[2]->position[j] - 
	         trianglet[i].kulmat[0]->position[j];
    }
    normVectorProd(hold1,hold2,trianglet[i].normal);
  }  

  /* Lasketaan jokaiselle lipun vertexille normaalit */
  for(i=0;i<(LIPUN_X_VERTEXIT)*(LIPUN_Y_VERTEXIT); i++) {
    GLfloat normaali[3]={0,0,0};
    for(j=0;j<vertexit[i].kolmiomaara;j++){
      normaali[0]+=trianglet[vertexit[i].kolmiot[j]].normal[0];
      normaali[1]+=trianglet[vertexit[i].kolmiot[j]].normal[1];
      normaali[2]+=trianglet[vertexit[i].kolmiot[j]].normal[2];
    }
    normaali[0]/=vertexit[i].kolmiomaara;
    normaali[1]/=vertexit[i].kolmiomaara;
    normaali[2]/=vertexit[i].kolmiomaara;
    vertexit[i].normal[0]=normaali[0];
    vertexit[i].normal[1]=normaali[1];
    vertexit[i].normal[2]=normaali[2];
  }
}



