/* idleFuncina toimiva p‰‰luuppi */
GLvoid runGL(GLvoid){
	boolean ready=false;
	framecounter=(int)calculatefps*currenttime/1000.0;
	int newframecounter=framecounter;
	while(!ready){
		processEvents();
		if(entterpressed || escpressed){
			entterpressed=false;
			escpressed=false;
			ready=true;
		}
		if(!ready){
			do{
				currenttime=SDL_GetTicks()-starttime;
				newframecounter=calculatefps*currenttime/1000.0;
				if(oldframecounter==newframecounter) SDL_Delay(1);
			}	while (oldframecounter==newframecounter);

			int skipframes=newframecounter-oldframecounter;
			oldframecounter=newframecounter;
			for(;skipframes>0;skipframes--){
				framecounter++;
				calculate(framecounter);
			}
		  Display();
			framesdrawn++;
		}
	}
}



