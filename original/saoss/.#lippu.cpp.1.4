void drawGround() {
  GLUquadricObj *temp=gluNewQuadric();

  gluQuadricTexture(temp, GL_TRUE);
  glTexEnvf(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_BLEND);
  glBindTexture(GL_TEXTURE_2D, texturet[0]);    
  
  glPushMatrix();
    glColor4f(0.1,0.5,0.0,0.5);
    glRotatef(-90,1,0,0);
    gluDisk(temp,0.0,30.0,30+10*sets->detail,1+1*sets->detail);
  glPopMatrix();
  gluDeleteQuadric(temp); 
}


/*	Lipputangon piirtofunktio ilman naruja.
*/
void drawPole() {
  GLUquadricObj *temp=gluNewQuadric();
  gluQuadricTexture(temp, GL_TRUE);
  glBindTexture(GL_TEXTURE_2D, texturet[0]);    
  
  glColor4f(0.8,0.7,0.8,0.5);

  glPushMatrix();
    glRotatef(-90.0,1,0,0);
    gluCylinder(temp,0.17,0.17,TANGON_KORKEUS,15+5*sets->detail,1+2*sets->detail);
  glPopMatrix();

  glColor4f(1,0.8,0.1,0.5);
  glPushMatrix();
    glTranslatef(0,TANGON_KORKEUS,0);
    gluSphere(temp,0.32,15+8*sets->detail,10+10*sets->detail);
  glPopMatrix();

  gluDeleteQuadric(temp); 
}

